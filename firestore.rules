rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
// Collection: publicacoes_rayane
// Document ID: UUID/string generated by the client
// Fields: id, texto, data, link, criada_em and owner_uid (all strings).
// Only the two Firebase Authentication accounts below may access it.

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAllowedUser() {
      return isAuthenticated() && request.auth.token.email in [
        'julianafelix.jf425@gmail.com',
        'rayanebmlima@gmail.com'
      ];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(data) {
      return data.owner_uid == request.auth.uid;
    }

    function uidNotModified(data) {
      return data.owner_uid == resource.data.owner_uid;
    }

    function isValidPublication(data) {
      return data.keys().hasAll(['id', 'texto', 'data', 'link', 'criada_em', 'owner_uid']) &&
        data.keys().hasOnly(['id', 'texto', 'data', 'link', 'criada_em', 'owner_uid']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 200 &&
        data.texto is string && data.texto.size() >= 1 && data.texto.size() <= 700000 &&
        data.data is string && data.data.size() <= 10 &&
        data.link is string && data.link.size() <= 2048 &&
        data.criada_em is string && data.criada_em.size() <= 40 &&
        data.owner_uid is string && data.owner_uid.size() <= 128;
    }

    match /publicacoes_rayane/{publicationId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser() &&
        request.resource.data.id == publicationId &&
        uidUnchanged(request.resource.data) &&
        isValidPublication(request.resource.data);
      allow update: if isAllowedUser() &&
        isOwner(resource.data.owner_uid) &&
        uidNotModified(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.criada_em == resource.data.criada_em &&
        isValidPublication(request.resource.data);
      allow delete: if isAllowedUser();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
